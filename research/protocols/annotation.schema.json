{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NSE frame annotations v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "codebookVersion",
    "sourceSha256",
    "profileSha256",
    "reviewer",
    "frames"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "codebookVersion": {
      "const": "visual-0.1"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "human",
            "ai_assisted"
          ]
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frameImage",
          "timestampSeconds",
          "categories"
        ],
        "properties": {
          "frameImage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "timestampSeconds": {
            "type": "number",
            "minimum": 0
          },
          "categories": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/category"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "evidence",
        "certainty"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "certainty": {
          "enum": [
            "clear",
            "uncertain"
          ]
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "status",
        "observations"
      ],
      "properties": {
        "category": {
          "enum": [
            "objects",
            "clothing",
            "setting",
            "actions"
          ]
        },
        "status": {
          "enum": [
            "not_reviewed",
            "none_visible",
            "observed",
            "uncertain"
          ]
        },
        "observations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_reviewed",
                  "none_visible"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observations": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "observations": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "observations": {
                "items": {
                  "properties": {
                    "certainty": {
                      "const": "clear"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "uncertain"
              }
            }
          },
          "then": {
            "properties": {
              "observations": {
                "contains": {
                  "properties": {
                    "certainty": {
                      "const": "uncertain"
                    }
                  },
                  "required": [
                    "certainty"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
